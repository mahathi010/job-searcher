{
  "version": 1,
  "project": {
    "name": "job_searcher",
    "scaffold_type": "frontend",
    "tech_stack": "Python 3.11",
    "capability_name": "job_searcher",
    "platform": "Mobile",
    "project_size": "Small"
  },
  "structure": {
    "directories": [
      "frontend/",
      "frontend/src/",
      "frontend/src/components/",
      "frontend/src/store/",
      "frontend/src/services/",
      "frontend/src/models/",
      "frontend/src/hooks/",
      "frontend/src/utils/",
      "frontend/src/types/",
      "frontend/src/constants/",
      "frontend/src/config/",
      "frontend/src/assets/",
      "frontend/src/styles/",
      "frontend/src/screens/",
      "frontend/src/navigation/",
      "frontend/src/native-modules/",
      "frontend/src/platform-assets/",
      "frontend/tests/",
      "docs/",
      "scripts/"
    ]
  },
  "conventions": {
    "naming_style": "snake_case for files, PascalCase for components",
    "test_pattern": "*.test.tsx / *.test.ts",
    "service_pattern": "*_service.ts",
    "model_pattern": "*_models.ts",
    "hook_pattern": "use_*.ts"
  },
  "path_mappings": {
    "src/main.tsx": "frontend/src/main.tsx",
    "src/styles/tokens.ts": "frontend/src/tokens.ts"
  },
  "rules": [
    "Do NOT reorganize the scaffolded folder structure.",
    "Place files in the directories indicated by path_mappings.",
    "Follow the naming conventions above for new files."
  ]
}
